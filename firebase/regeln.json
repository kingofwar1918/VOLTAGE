{
  "rules": {
    ".read": false,
    ".write": false,

    "voltage": {
      "spiele": {
        "$code": {
          ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
          ".write": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",

          "spiel": {
            ".validate": "newData.hasChildren(['name', 'code', 'status', 'runde', 'level', 'version']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('code').val() === $code && newData.child('runde').isNumber() && newData.child('level').isNumber() && newData.child('version').isNumber()"
          },
          "firmen": {
            "$fid": {
              ".validate": "$fid.matches(/^[a-z0-9]{3,20}$/) && newData.hasChildren(['id', 'name']) && newData.child('id').val() === $fid && newData.child('name').isString() && newData.child('name').val().length <= 24"
            }
          },
          "entscheide": {
            "$runde": {
              ".validate": "$runde.matches(/^r[0-9]{1,3}$/)",
              "$fid": {
                ".validate": "$fid.matches(/^[a-z0-9]{3,20}$/) && newData.hasChild('zeit') && newData.child('zeit').isNumber()"
              }
            }
          },
          "resultate": {
            "$runde": {
              ".validate": "$runde.matches(/^r[0-9]{1,3}$/) && newData.hasChildren(['runde', 'firmen'])"
            }
          },
          "reflexion": {
            "$teil": {
              ".validate": "$teil.matches(/^(l[1-5]|transfer)$/)",
              "$fid": {
                ".validate": "$fid.matches(/^[a-z0-9]{3,20}$/) && newData.hasChild('zeit')",
                "antworten": {
                  "$frage": { ".validate": "newData.isString() && newData.val().length <= 1000" }
                }
              }
            }
          },
          "$andere": { ".validate": false }
        }
      },

      "lehrer": {
        "$code": {
          "$hash": {
            ".read": true,
            ".write": "!root.child('voltage/lehrer/' + $code).exists()",
            ".validate": "newData.val() === true && $hash.matches(/^[0-9a-f]{16}$/)"
          }
        }
      }
    }
  }
}
